{
  "name": "enso",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --exclude '**/*.live.test.ts'",
    "test:live": "vitest run live.test.ts",
    "test:watch": "vitest --exclude '**/*.live.test.ts'",
    "demo": "tsx scripts/demo.ts",
    "chat": "node --env-file=.env --import tsx scripts/chat.ts",
    "mint-token": "node --env-file=.env --import tsx scripts/mintAdminIdToken.ts",
    "typecheck": "tsc --noEmit",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@google/genai": "^2.18.0",
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "12.4.1",
    "double-metaphone": "^2.0.1",
    "fastest-levenshtein": "^1.0.16",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "next": "^16.3.1",
    "openai": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sqlite-vec": "^0.1.9",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
